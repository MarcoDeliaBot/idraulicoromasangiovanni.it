{
  "name": "idraulicoromasangiovanni-static",
  "main": "worker/index.mjs",
  "compatibility_date": "2024-09-23",
  "routes": [
    { "pattern": "idraulicoromasangiovanni.it/*", "zone_name": "idraulicoromasangiovanni.it" },
    { "pattern": "www.idraulicoromasangiovanni.it/*", "zone_name": "idraulicoromasangiovanni.it" }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  }
}

